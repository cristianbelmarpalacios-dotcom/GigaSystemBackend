// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  PC_COMPONENT
  PERIPHERAL
  PREBUILT_PC
  ACCESSORY
}

enum ProductStatus {
  PUBLISHED
  ARCHIVED
}

enum CategoryStatus {
  PUBLISHED
  ARCHIVED
}

/** Pieza del armador 3D (catálogo → carrito → vista 3D). */
enum Pc3dBuilderSlot {
  NONE
  GABINETE
  PROCESADOR
  TARJETA_MADRE
  RAM
  TARJETA_GRAFICA
  ALMACENAMIENTO
  FUENTE_PODER
  REFRIGERACION
}

/**
 * Variante visual del gabinete en 3D.
 * WHITE = chasis blanco de referencia (ReferenceChassisV1).
 * BLACK = chasis negro (misma base, materiales oscuros; diseño dedicado después).
 * NONE = el producto no aporta vista 3D de gabinete.
 */
enum Pc3dCaseVariant {
  NONE
  WHITE
  BLACK
}

enum ImageRole {
  MAIN
  GALLERY
  THUMB
  /** Imágenes grandes en la sección de descripción (no en la galería). */
  DETAIL
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AllocationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum AdminModule {
  DASHBOARD
  ORDERS
  PRODUCTS
  CATEGORIES
  USERS
  ROLES
  HELP
  HOMEPAGE
}

model AdminRole {
  id          String                @id @default(cuid())
  name        String                @unique
  slug        String                @unique
  description String?
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  permissions AdminRolePermission[]
  users       User[]
}

model AdminRolePermission {
  id        String      @id @default(cuid())
  roleId    String
  role      AdminRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AdminModule
  canView   Boolean     @default(false)
  canEdit   Boolean     @default(false)
  canDelete Boolean     @default(false)

  @@unique([roleId, module])
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  role          UserRole             @default(CUSTOMER)
  adminRoleId   String?
  adminRole     AdminRole?           @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)
  firstName     String?
  lastName      String?
  phone         String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  recipient  String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  isBilling  Boolean  @default(false)
  isShipping Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Entradas fijas del menú principal (ej. Armador de PC), no son categorías de catálogo.
model NavFixedItem {
  id                 String   @id @default(cuid())
  slug               String   @unique
  label              String
  href               String
  description        String?
  navImageUrl        String?
  navImageStorageKey String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  /// Imagen de fondo del mega menú (solo categorías raíz del menú principal).
  navImageUrl        String?
  navImageStorageKey String?
  status      CategoryStatus    @default(ARCHIVED)
  parentId    String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Product {
  id             String            @id @default(cuid())
  type           ProductType
  status         ProductStatus     @default(ARCHIVED)
  brandId        String?
  brand          Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name           String
  slug           String            @unique
  shortDesc      String?
  description    String?
  seoTitle       String?
  seoDescription String?
  basePrice      Decimal?          @db.Decimal(12, 2)
  currency       String            @default("COP")
  specsJson      Json?
  isFeatured     Boolean           @default(false)
  /** Rol en el armado 3D (procesador, RAM, gabinete, etc.). */
  pc3dBuilderSlot Pc3dBuilderSlot  @default(NONE)
  /** Solo gabinetes: blanco (diseño actual), negro (futuro) o sin 3D. */
  pc3dCaseVariant Pc3dCaseVariant  @default(NONE)
  /**
   * Sigla opcional en SKU (ej. DF-WHITE). Si el SKU de la variante la contiene,
   * se usa junto con pc3dCaseVariant para el armado.
   */
  pc3dCaseSigla  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  variants       ProductVariant[]
  categories     ProductCategory[]
  images         ProductImage[]
  assets3D       ProductAsset3D[]
  tags           ProductTag[]
  homeTiles      HomeTile[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String              @unique
  ean                String?
  name               String?
  price              Decimal             @db.Decimal(12, 2)
  comparePrice       Decimal?            @db.Decimal(12, 2)
  stock              Int                 @default(0)
  isActive           Boolean             @default(true)
  specsJson          Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventory          InventoryItem[]
  stockMovement      StockMovement[]
  allocations        Allocation[]
  cartLines          CartLine[]
  orderLines         OrderLine[]
  assets3D           ProductAsset3D[]
  supplierOrderLines SupplierOrderLine[]
}

model ProductImage {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  role       ImageRole @default(GALLERY)
  sortOrder  Int       @default(0)
  storageKey String
  url        String
  mimeType   String
  width      Int?
  height     Int?
  hash       String?
  fileSize   Int?
  createdAt  DateTime  @default(now())
}

model ProductAsset3D {
  id         String          @id @default(cuid())
  productId  String
  variantId  String?
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  storageKey String
  url        String
  mimeType   String
  fileSize   Int
  hasPreview Boolean         @default(true)
  scale      Float?
  positionX  Float?
  positionY  Float?
  positionZ  Float?
  rotationX  Float?
  rotationY  Float?
  rotationZ  Float?
  createdAt  DateTime        @default(now())
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  products  ProductTag[]
  createdAt DateTime     @default(now())
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  isActive  Boolean         @default(true)
  inventory InventoryItem[]
  createdAt DateTime        @default(now())
}

model InventoryItem {
  id          String         @id @default(cuid())
  warehouseId String
  variantId   String
  quantity    Int            @default(0)
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([warehouseId, variantId])
}

model StockMovement {
  id          String            @id @default(cuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int
  note        String?
  referenceId String?
  createdAt   DateTime          @default(now())
}

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  token        String?    @unique
  currency     String     @default("COP")
  isCheckedOut Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lines        CartLine[]
}

model CartLine {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal        @db.Decimal(12, 2)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  userId          String?
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          OrderStatus          @default(CREATED)
  subtotal        Decimal              @db.Decimal(12, 2)
  taxTotal        Decimal              @db.Decimal(12, 2)
  shippingTotal   Decimal              @db.Decimal(12, 2)
  discountTotal   Decimal              @db.Decimal(12, 2)
  grandTotal      Decimal              @db.Decimal(12, 2)
  currency        String               @default("COP")
  billingAddress  Json?
  shippingAddress Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lines           OrderLine[]
  payments        Payment[]
  statusHistory   OrderStatusHistory[]
  allocations     Allocation[]
  shipments       Shipment[]
}

model OrderLine {
  id          String         @id @default(cuid())
  orderId     String
  variantId   String
  quantity    Int
  unitPrice   Decimal        @db.Decimal(12, 2)
  productName String
  variantSku  String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
}

model Allocation {
  id        String           @id @default(cuid())
  orderId   String
  variantId String
  quantity  Int
  status    AllocationStatus @default(RESERVED)
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  userId            String?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider          String
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("COP")
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Shipment {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier      String?
  trackingCode String?
  status       String
  weightGrams  Int?
  shippingCost Decimal? @db.Decimal(12, 2)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  isActive       Boolean         @default(true)
  purchaseOrders SupplierOrder[]
  createdAt      DateTime        @default(now())
}

model SupplierOrder {
  id         String              @id @default(cuid())
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  code       String              @unique
  status     String
  createdAt  DateTime            @default(now())
  lines      SupplierOrderLine[]
}

model SupplierOrderLine {
  id              String         @id @default(cuid())
  supplierOrderId String
  variantId       String
  quantity        Int
  unitCost        Decimal        @db.Decimal(12, 2)
  supplierOrder   SupplierOrder  @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model ImportJob {
  id          String         @id @default(cuid())
  fileKey     String
  status      String
  totalRows   Int            @default(0)
  successRows Int            @default(0)
  errorRows   Int            @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  rows        ImportJobRow[]
}

model ImportJobRow {
  id          String    @id @default(cuid())
  importJobId String
  rowNumber   Int
  payload     Json
  status      String
  error       String?
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
}

enum HomeSectionType {
  HERO_BANNER
  STRIP_BANNER
  WELCOME_BLOCK
  DEALS_CAROUSEL
  BANNER_GRID
}

enum HomeTileLayout {
  VERTICAL
  HORIZONTAL
}

model HomeSection {
  id                   String          @id @default(cuid())
  type                 HomeSectionType @unique
  title                String?
  subtitle             String?
  isActive             Boolean         @default(true)
  sortOrder            Int             @default(0)
  backgroundImageUrl   String?
  backgroundStorageKey String?
  /** Velo blanco sobre el fondo (0 = imagen visible, 100 = casi oculta) */
  backgroundOverlayOpacity Int @default(50)
  /** Difuminado del fondo en píxeles (0 = nítida, 24 = muy borrosa) */
  backgroundBlurPx       Int @default(6)
  slides               HomeSlide[]
  promo     HomePromo?
  tiles     HomeTile[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model HomeSlide {
  id         String      @id @default(cuid())
  sectionId  String
  section    HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  imageUrl   String
  storageKey String
  linkUrl    String
  altText    String?
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
}

model HomePromo {
  id         String      @id @default(cuid())
  sectionId  String      @unique
  section    HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  imageUrl   String
  storageKey String
  linkUrl    String
  heading    String?
  subheading String?
  ctaLabel   String?
  updatedAt  DateTime    @updatedAt
}

model HomeTile {
  id         String         @id @default(cuid())
  sectionId  String
  section    HomeSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  layout     HomeTileLayout
  imageUrl   String
  storageKey String
  linkUrl    String
  title      String
  eyebrow    String?
  priceLabel String?
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
}
