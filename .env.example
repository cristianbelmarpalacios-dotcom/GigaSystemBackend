NODE_ENV=development
PORT=4000

# --- Supabase (Prisma): Project Settings → Database → Connect → ORM → Prisma ---
# Pooler (puerto 6543): uso diario del API Nest
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct (puerto 5432): migraciones (`prisma migrate deploy`)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Local (docker compose) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gigasystem?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/gigasystem?schema=public

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Imágenes: Supabase Storage (recomendado, mismo proyecto que la DB) ---
# Dashboard → Storage → New bucket → nombre ej. gigasystem-assets → Public bucket
# Settings → API → service_role (solo backend, nunca en el front)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=gigasystem-assets

# --- Alternativa local: MinIO (STORAGE_PROVIDER=s3) ---
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=minio123
# S3_BUCKET=gigasystem-assets
# S3_FORCE_PATH_STYLE=true

REDIS_URL=redis://localhost:6379

PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcional: origen del front en producción
# CORS_ORIGIN=https://tu-dominio.cl

# --- Marketing / OAuth (backoffice → Plataformas) ---
# Debe coincidir con redirect URI en Meta → Inicio de sesión con Facebook
API_PUBLIC_URL=http://localhost:4000
ADMIN_APP_URL=http://localhost:3000

# Meta: Configuración básica → Identificador + Clave secreta
META_APP_ID=
META_APP_SECRET=

# Google: console.cloud.google.com → OAuth + Google Ads API
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Token de desarrollador Google Ads (para importar gasto/clics)
GOOGLE_ADS_DEVELOPER_TOKEN=
